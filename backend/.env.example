DATABASE_URL=postgresql://postgres:postgres@db:5432/fixya_db
SECRET_KEY=tu_clave_secreta
RUN_SEED=true
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4-mini

# IA de moderacion y clasificacion de resenas.
# Orden de proveedores: Groq -> Gemini -> analisis local (sin clave).
# Basta configurar UNO. Si ambos estan vacios, se usa el analisis local.

# Groq (recomendado: gratis, sin tarjeta). Clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (capa gratuita). Clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

